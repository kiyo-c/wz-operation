{
  "name": "wz-operation",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.4.0",
  "publisher": "kiyoc",
  "author": {
    "name": "kiyoc"
  },
  "license": "MIT",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Keymaps"
  ],
  "keywords": [
    "WZ",
    "WZ Editor",
    "keybinding",
    "keyboard",
    "F5",
    "F6",
    "F7",
    "F8",
    "F9",
    "word",
    "selection",
    "copy",
    "cut",
    "paste",
    "clipboard stack",
    "Japanese",
    "キーバインド",
    "キーボード",
    "コピー",
    "切り取り",
    "貼り付け",
    "クリップボード",
    "スタック"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "contributes": {
    "configurationDefaults": {
      "editor.editContext": false
    },
    "commands": [
      {
        "command": "wzOperation.toggleSelectionMode",
        "title": "%command.toggleSelectionMode.title%"
      },
      {
        "command": "wzOperation.pickKeywordAndAddSelection",
        "title": "%command.pickKeywordAndAddSelection.title%"
      },
      {
        "command": "wzOperation.pastePickedKeyword",
        "title": "%command.pastePickedKeyword.title%"
      },
      {
        "command": "wzOperation.cutToStack",
        "title": "%command.cutToStack.title%"
      },
      {
        "command": "wzOperation.copyToStack",
        "title": "%command.copyToStack.title%"
      },
      {
        "command": "wzOperation.pasteAndPopStack",
        "title": "%command.pasteAndPopStack.title%"
      },
      {
        "command": "wzOperation.pasteStack",
        "title": "%command.pasteStack.title%"
      },
      {
        "command": "wzOperation.showCopyStack",
        "title": "%command.showCopyStack.title%"
      },
      {
        "command": "wzOperation.pasteAndConsumeFromCopyStackList",
        "title": "%command.pasteAndConsumeFromCopyStackList.title%"
      },
      {
        "command": "wzOperation.clearCopyStack",
        "title": "%command.clearCopyStack.title%"
      },
      {
        "command": "wzOperation.resetEditContextWarningState",
        "title": "%command.resetEditContextWarningState.title%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "wzOperation.copyStack.maxTotalSizeMiB": {
          "type": "number",
          "default": 64,
          "minimum": 1,
          "title": "%configuration.maxTotalSizeMiB.title%",
          "markdownDescription": "%configuration.maxTotalSizeMiB.description%"
        },
        "wzOperation.copyStack.maxItemSizeMiB": {
          "type": "number",
          "default": 16,
          "minimum": 1,
          "title": "%configuration.maxItemSizeMiB.title%",
          "markdownDescription": "%configuration.maxItemSizeMiB.description%"
        },
        "wzOperation.copyStack.osClipboardIntegration": {
          "type": "boolean",
          "default": true,
          "title": "%configuration.osClipboardIntegration.title%",
          "markdownDescription": "%configuration.osClipboardIntegration.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "wzOperation.cancelSelectionMode",
        "key": "escape",
        "when": "editorTextFocus && wzOperation.selectionMode"
      },
      {
        "command": "actions.find",
        "key": "f6",
        "when": "editorTextFocus"
      },
      {
        "command": "editor.action.startFindReplaceAction",
        "key": "f7",
        "when": "editorTextFocus"
      },
      {
        "command": "wzOperation.toggleSelectionMode",
        "key": "f10",
        "when": "editorTextFocus"
      },
      {
        "command": "cursorLeftSelect",
        "key": "left",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "cursorRightSelect",
        "key": "right",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "cursorUpSelect",
        "key": "up",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "cursorDownSelect",
        "key": "down",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "cursorHomeSelect",
        "key": "home",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "cursorEndSelect",
        "key": "end",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "cursorPageUpSelect",
        "key": "pageup",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "cursorPageDownSelect",
        "key": "pagedown",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "cursorWordStartLeftSelect",
        "key": "ctrl+left",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "cursorWordEndRightSelect",
        "key": "ctrl+right",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "cursorTopSelect",
        "key": "ctrl+home",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "cursorBottomSelect",
        "key": "ctrl+end",
        "when": "editorTextFocus && wzOperation.selectionMode && !suggestWidgetVisible"
      },
      {
        "command": "wzOperation.pickKeywordAndAddSelection",
        "key": "f5",
        "when": "editorTextFocus"
      },
      {
        "command": "wzOperation.pastePickedKeyword",
        "key": "shift+f5",
        "when": "editorTextFocus"
      },
      {
        "command": "wzOperation.cutToStack",
        "key": "f8",
        "when": "editorTextFocus"
      },
      {
        "command": "wzOperation.copyToStack",
        "key": "shift+f8",
        "when": "editorTextFocus"
      },
      {
        "command": "wzOperation.pasteAndPopStack",
        "key": "f9",
        "when": "editorTextFocus"
      },
      {
        "command": "wzOperation.pasteStack",
        "key": "shift+f9",
        "when": "editorTextFocus"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kiyo-c/wz-operation.git"
  },
  "homepage": "https://github.com/kiyo-c/wz-operation#readme",
  "bugs": {
    "url": "https://github.com/kiyo-c/wz-operation/issues"
  }
}
